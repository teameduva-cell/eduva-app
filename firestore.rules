rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 🔐 FOUNDER ONLY — aapka founder email yahan daalo
    function isFounder() {
      return request.auth != null && request.auth.token.email == "FOUNDER_EMAIL_YAHAN";
    }

    // Students: apna doc padho/update karo; puri list sirf founder
    match /students/{uid} {
      allow read: if request.auth != null && (request.auth.uid == uid || isFounder());
      allow create: if request.auth != null && request.auth.uid == uid;
      allow update: if request.auth != null && (request.auth.uid == uid || isFounder());
      allow delete: if request.auth != null && (request.auth.uid == uid || isFounder());
    }

    // Partner leads: form se koi bhi create; padhna sirf founder
    match /partnerLeads/{id} {
      allow create: if true;
      allow read, delete: if isFounder();
      allow update: if false;
    }

    // Content bank: padhna sirf founder; likhna logged-in
    match /contentBank/{id} {
      allow read, delete: if isFounder();
      allow create: if request.auth != null;
      allow update: if false;
    }

    // Founder config: sirf founder (PIN hash!)
    match /config/{docId} {
      allow read, write: if isFounder();
    }

    // AIT / Rooms / RefRewards / Analytics: logged-in read/write (app features)
    // ✍️ Creator registration leads
    match /creatorLeads/{doc} {
      allow create: if true;
      allow read, delete: if isFounder();
      allow update: if false;
    }

    match /{c}/{id} {
      allow read, create: if request.auth != null;
      allow update, delete: if request.auth != null && (isFounder() ||
        (c in ['aitRegistrations','aitResults','refRewards'] &&
         resource.data.uid == request.auth.uid));
    }
  }
}