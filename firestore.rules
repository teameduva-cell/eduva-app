rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isFounder() {
      return request.auth != null
        && request.auth.token.email == 'team.eduva@gmail.com';
    }

    // 👤 FIX #2: doc ka naam hi uid hai
    match /students/{doc} {
      allow read: if request.auth != null
        && (request.auth.uid == doc || isFounder());
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null
        && (request.auth.uid == doc || isFounder());
    }

    // 📚 Content Bank (same)
    match /contentBank/{doc} {
      allow create, read: if request.auth != null;
      allow delete: if isFounder();
    }

    // 🧠 stats (same)
    match /stats/{doc} {
      allow read, write: if true;
    }

    // 🔐 Founder config (same)
    match /config/{doc} {
      allow read, write: if isFounder();
    }

    // 🏆 AIT (papers same)
    match /aitPapers/{level} {
      allow read: if request.auth != null;
      allow write: if isFounder();
    }
    // FIX #3: owner apne docs padh/delete kar sake (account deletion)
    match /aitRegistrations/{doc} {
      allow create: if request.auth != null;
      allow read, delete: if isFounder()
        || (request.auth != null && resource.data.uid == request.auth.uid);
    }
    match /aitResults/{doc} {
      allow create: if request.auth != null;
      allow read, delete: if isFounder()
        || (request.auth != null && resource.data.uid == request.auth.uid);
    }

    // 👥 rooms (same)
    match /rooms/{code} {
      allow read, write: if request.auth != null;
    }

    // 🎁 refRewards (same)
    match /refRewards/{doc} {
      allow read, create, update: if request.auth != null;
    }

    // 📈 analytics (same)
    match /analytics/{doc} {
      allow create: if true;
      allow read, delete: if isFounder();
    }

    // ⚡ qaCache (same — backend ke liye zaroori!)
    match /qaCache/{doc} {
      allow read, write: if true;
    }

    // 🤝 FIX #1: Partner leads — form se koi bhi bharo, padhna sirf founder
    match /partnerLeads/{doc} {
      allow create: if true;
      allow read, delete: if isFounder();
      allow update: if false;
    }

    // 🌐 Shared Question Bank: sab bachche padh/save kar sakte hain; update/delete sirf founder
    match /qbank/{qid} {
      allow read, create: if true;
      allow update, delete: if isFounder();
    }

    // ❌ DEFAULT (same)
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
